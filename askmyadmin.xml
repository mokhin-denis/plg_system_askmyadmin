<?xml version="1.0" encoding="utf-8"?>
<extension type="plugin" group="system" method="upgrade">
	<name>plg_system_askmyadmin</name>
	<author>Denis Mokhin</author>
	<authorUrl>https://mokhin-tech.ru</authorUrl>
	<creationDate>09.12.2014</creationDate>
	<copyright>Copyright (C) 2013-2019 Denis Mokhin - All rights reserved.</copyright>
	<license>GNU GPL, please visit http://www.gnu.org/licenses/gpl-2.0.html or see LICENSE.txt</license>
	<authorEmail>denis@mokhin-tech.ru</authorEmail>
	<version>2.0.0</version>
	<description>PLG_SYSTEM_ASKMYADMIN_DESC</description>
	<namespace path="src">Joomla\Plugin\System\AskMyAdmin</namespace>
	<files>
		<folder plugin="askmyadmin">services</folder>
		<folder>src</folder>
		<filename>README.md</filename>
		<filename>LICENSE.txt</filename>
		<folder>language</folder>
	</files>
	<scriptfile>script.php</scriptfile>
	<languages>
		<language tag="en-GB">language/en-GB/en-GB.plg_system_askmyadmin.ini</language>
		<language tag="en-GB">language/en-GB/en-GB.plg_system_askmyadmin.sys.ini</language>
		<language tag="fr-FR">language/fr-FR/fr-FR.plg_system_askmyadmin.ini</language>
		<language tag="fr-FR">language/fr-FR/fr-FR.plg_system_askmyadmin.sys.ini</language>
		<language tag="it-IT">language/it-IT/it-IT.plg_system_askmyadmin.ini</language>
		<language tag="it-IT">language/it-IT/it-IT.plg_system_askmyadmin.sys.ini</language>
		<language tag="pl-PL">language/pl-PL/pl-PL.plg_system_askmyadmin.ini</language>
		<language tag="pl-PL">language/pl-PL/pl-PL.plg_system_askmyadmin.sys.ini</language>
		<language tag="ru-RU">language/ru-RU/ru-RU.plg_system_askmyadmin.ini</language>
		<language tag="ru-RU">language/ru-RU/ru-RU.plg_system_askmyadmin.sys.ini</language>
	</languages>
	<config>
	<fields name="params">
		<fieldset name="basic">
			<field name="keyname" type="text" size="45" required="true" label="PLG_SYSTEM_ASKMYADMIN_KEYNAME" description="PLG_SYSTEM_ASKMYADMIN_KEYNAME_DESC" />
			<field name="keyvalue" type="password" size="45" required="true" label="PLG_SYSTEM_ASKMYADMIN_KEYVALUE" description="PLG_SYSTEM_ASKMYADMIN_KEYVALUE_DESC" />
            <field name="url" type="url" default="" label="PLG_SYSTEM_ASKMYADMIN_URL" description="PLG_SYSTEM_ASKMYADMIN_URL_DESC" size="45" />
		</fieldset>
	</fields>
	</config>
</extension>
